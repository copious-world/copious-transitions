{
    "name": "copious-transitions",
    "version": "0.8.3",
    "description": "Framework for working with frameworks",
    "directories": {
        "lib": "lib"
    },
    "main": "index.js",
    "bin": {
        "copious-captcha": "./bin/index.js --turbo-fast-api-calls",
        "copious-db-tool": "./tools/db_and_connection_operations.js"
    },
    "scripts": {
        "test": "node tests/runall.js",
        "gen-docs": "jsdoc --configure ./tools/jsdoc.conf -a all -R README.md --verbose"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rleddy/copious-transitions.git"
    },
    "funding": {
        "type": "GitHub Sponsors",
        "url": "https://github.com/sponsors/copious-world"
    },
    "keywords": [
        "node",
        "js",
        "sandwich",
        "framework",
        "authorization",
        "permission",
        "state",
        "state-transitions",
        "tokens",
        "session",
        "micro-service",
        "gateway"
    ],
    "author": "Richard Leddy",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/rleddy/copious-transitions/issues"
    },
    "homepage": "https://github.com/rleddy/copious-transitions#readme",
    "dependencies": {
        "@polka/send-type": "^0.5.2",
        "body-parser": "^2.4.0",
        "com_link_manager": "^0.2.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "extra-file-class": "^1.0.4",
        "message-relay-services": "^0.9.30",
        "polka": "^0.5.2",
        "session_tokens": "^1.0.1",
        "state-tokens": "^1.0.4",
        "svg-captcha": "^1.4.0",
        "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "node-gyp": "^13.1.0",
        "node-scp": "^1.0.0",
        "tape": "^5.10.3",
        "tar": "^7.5.22",
        "terser": "^5.51.2"
    },
    "allowScripts": {
        "cpu-features@0.0.10": true,
        "ssh2@1.17.0": true
    }
